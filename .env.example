# =============================================================================
# MANZILI — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# Get from: Supabase Dashboard → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -----------------------------------------------------------------------------
# Database (required)
# Use the Supabase "Transaction" pooler URL for Vercel/serverless (port 6543)
# Supabase Dashboard → Settings → Database → Connection string → URI
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.your-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# -----------------------------------------------------------------------------
# App (required)
# Set NEXT_PUBLIC_APP_URL to your production domain on Vercel
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://manzili.eg
NEXT_PUBLIC_APP_NAME=Manzili

# -----------------------------------------------------------------------------
# Admin Panel (required)
# ADMIN_EMAILS: comma-separated list of allowed admin emails
# ADMIN_PASSWORD_HASH_B64: bcrypt hash base64-encoded (avoids $ expansion)
#   Generate: node -e "require('bcrypt').hash('YourPw',12).then(h=>console.log(Buffer.from(h).toString('base64')))"
# ADMIN_SESSION_SECRET: random string — generate with: openssl rand -base64 32
# -----------------------------------------------------------------------------
ADMIN_EMAILS=admin@yourdomain.com
ADMIN_PASSWORD_HASH_B64=your_bcrypt_hash_base64_encoded
ADMIN_SESSION_SECRET=replace_with_openssl_rand_base64_32_output

# -----------------------------------------------------------------------------
# Paymob — Payment gateway (optional: mock mode if empty)
# Get from: https://accept.paymob.com/portal2/en/settings
# -----------------------------------------------------------------------------
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_CARD_INTEGRATION_ID=your_card_integration_id
PAYMOB_FAWRY_INTEGRATION_ID=your_fawry_integration_id
PAYMOB_WALLET_INTEGRATION_ID=your_wallet_integration_id
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret
PAYMOB_IFRAME_ID=your_paymob_iframe_id

# -----------------------------------------------------------------------------
# ValU BNPL — Buy Now Pay Later (optional: mock mode if empty)
# -----------------------------------------------------------------------------
VALU_MERCHANT_ID=your_valu_merchant_id
VALU_API_KEY=your_valu_api_key
VALU_API_URL=https://api.valu.com.eg/v1

# -----------------------------------------------------------------------------
# Twilio — SMS + WhatsApp OTP (optional: console mock if empty)
# Get from: https://console.twilio.com
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# -----------------------------------------------------------------------------
# Resend — Transactional email (optional: notifications skipped if empty)
# Get from: https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# Google Maps (optional: falls back to OpenStreetMap/Leaflet if empty)
# Get from: https://console.cloud.google.com → Maps JavaScript API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
